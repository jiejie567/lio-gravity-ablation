# Reproducible ROS1/Noetic environment for the LIO-SAM gravity/b_a ablation.
#
# GTSAM's gravity-aware IMU factor landed after the 4.0 release used by the
# original LIO-SAM.  Pin the exact upstream revision so that the experiment is
# not silently changed by future updates to the develop branch.
FROM fastlio_exp:noetic

ARG GTSAM_COMMIT=79ace0dbde0d9fb74d82cec473330479b4e54276

RUN apt-get update && apt-get install -y --no-install-recommends \
    libboost-all-dev libtbb-dev \
    ros-noetic-navigation \
    ros-noetic-robot-localization \
    ros-noetic-robot-state-publisher \
    ros-noetic-cv-bridge \
    && rm -rf /var/lib/apt/lists/*

COPY docker/gtsam-cmake-3.16.patch /tmp/gtsam-cmake-3.16.patch

RUN git clone --filter=blob:none https://github.com/borglab/gtsam.git /opt/gtsam \
    && cd /opt/gtsam \
    && git checkout "${GTSAM_COMMIT}" \
    && git apply /tmp/gtsam-cmake-3.16.patch \
    && cmake -S . -B build \
        -DCMAKE_BUILD_TYPE=Release \
        -DGTSAM_BUILD_EXAMPLES_ALWAYS=OFF \
        -DGTSAM_BUILD_TESTS=OFF \
        -DGTSAM_BUILD_UNSTABLE=OFF \
        -DGTSAM_BUILD_WITH_MARCH_NATIVE=OFF \
        -DGTSAM_WITH_TBB=OFF \
        -DGTSAM_USE_SYSTEM_EIGEN=OFF \
        -DGTSAM_BUILD_PYTHON=OFF \
    && cmake --build build --parallel 2 \
    && cmake --install build \
    && ldconfig \
    && rm -rf /opt/gtsam/.git /opt/gtsam/build

# ROS Noetic's PCL package points at Ubuntu's Eigen 3.3 headers, while the
# pinned GTSAM revision requires Eigen 3.4. Keep one header tree process-wide;
# mixing both versions in a single translation unit is ABI-unsafe and GTSAM
# explicitly rejects it at compile time.
RUN ln -s /opt/gtsam/gtsam/3rdparty/Eigen/unsupported \
        /usr/local/include/gtsam/3rdparty/Eigen/unsupported \
    && rm -rf /usr/include/eigen3 \
    && ln -s /usr/local/include/gtsam/3rdparty/Eigen /usr/include/eigen3

WORKDIR /work
